# ---- окружение ----
COMPOSE_PROJECT_NAME=dortech-prod        # dortech-test | dortech-prod
ENVIRONMENT=production                   # development | test | production
DEBUG=0
SECRET_KEY=change-me-64-random-chars
SITE_URL=https://dortech.example.com
NEXT_PUBLIC_SITE_URL=https://dortech.example.com
ALLOWED_HOSTS=dortech.example.com
ADMIN_URL_PATH=panel-x7
UVICORN_WORKERS=4

# ---- база данных ----
POSTGRES_DB=dortech
POSTGRES_USER=dortech
POSTGRES_PASSWORD=change-me
# DATABASE_URL задаётся compose автоматически; для локальной разработки:
# DATABASE_URL=postgresql+asyncpg://dortech:dortech@localhost:5432/dortech

# ---- почта (SMTP Заказчика) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=change-me
SMTP_USE_TLS=1
DEFAULT_FROM_EMAIL=Дортех <noreply@example.com>
NOTIFICATION_EMAILS=manager@example.com

# ---- webhook ----
WEBHOOK_URL=
WEBHOOK_SECRET=change-me
WEBHOOK_SINK_ENABLED=0

# ---- файлы и ограничения ----
MAX_UPLOAD_MB=20
RATE_LIMIT_ENABLED=1

# ---- SEO ----
ROBOTS_ALLOW=1

# ---- наблюдаемость ----
SENTRY_DSN=
LOG_LEVEL=INFO
BACKUP_RETENTION_DAYS=14
